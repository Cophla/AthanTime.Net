# Generated builds, installers, tests and offline-builder caches.
**/[Bb]in/
**/[Oo]bj/
**/publish/
/artifacts/
**/TestResults/
/.location-cache/
# The versioned ZIP supplies this generated builder output; app builds unpack under obj/.
/AthanTime.Net/Data/locations.db
/AthanTime.Net/Data/locations.db.tmp
/AthanTime.Net/Data/locations.db.zip.tmp
*.binlog

# Test and coverage reports may be written outside TestResults/.
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
coverage.opencover.xml

# Local diagnostic dumps/traces and macOS debug-symbol bundles.
*.dmp
*.stackdump
*.nettrace
*.netperf
*.gcdump
*.dSYM/
*.log
AthanTime-logs*.zip
AthanTime-settings*.json

# Local IDE state and publish profiles; canonical packaging lives in packaging/.
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pubxml
*.pubxml.user
*.publishsettings
*.code-workspace
*~
*.swp
*.swo

# OS-created metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini

# Private signing material. Signing uses an external certificate store/provider.
*.pfx
*.p12
*.pvk
*.snk
*.key
*.pem
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Local environment secrets; explicitly named examples may be reviewed and shared.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Device-local profiles accidentally copied into the checkout root.
/settings.json
/settings.json.bak
/settings.json.tmp
/settings.json.bak.tmp
/window-position.json
/window-position.json.tmp

# Local agent configuration/cache; AGENTS.md is the shared engineering guide.
/.codex/
/.agents/
